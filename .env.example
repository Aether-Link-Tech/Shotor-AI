APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./shot_or.db
ACCESS_TOKEN_EXPIRE_MINUTES=30
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10
MAX_EXTRACTED_TEXT_CHARS=250000
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Free local model: run `ollama pull llama3.2` first. Must match a name from `ollama list`.
# Optional: a free-tier cloud model (after `ollama signin`), e.g. a tag ending in :cloud - light usage, not offline.
OLLAMA_MODEL=llama3.2
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=120
OLLAMA_MAX_OUTPUT_TOKENS=1200
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_STATE_TTL_MINUTES=10
# Extra browser origins allowed to call the API (comma separated). localhost/127.0.0.1 on :5500 and :8000 are always allowed in development.
ALLOWED_ORIGINS=
# Only needed if the web UI is hosted somewhere other than the API (e.g. http://localhost:5500). Empty = same origin.
FRONTEND_URL=
