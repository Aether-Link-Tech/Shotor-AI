{
  "name": "shotor-ai",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.22",
    "expo-auth-session": "~58.0.16",
    "expo-background-task": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "jszip": "^3.10.2",
    "llama.rn": "^0.13.0-rc.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "pdfjs-dist": "^6.4.299",
    "typescript": "~6.0.3",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "@types/jest": "30.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "gen:pdfjs": "node scripts/gen-pdfjs.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "prebuild": "expo prebuild --clean",
    "build:apk": "expo prebuild --platform android --clean && cd android && gradlew assembleRelease",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^llama.rn$": "<rootDir>/test/llamaMock.js"
    }
  }
}
